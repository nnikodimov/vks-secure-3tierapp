# Copy to terraform.tfvars (gitignored) and fill in.

nsx_manager_host     = "nsx-manager.example.com"
nsx_username         = "admin"
nsx_password         = "changeme"
allow_unverified_ssl = false

# Override only if reapplying against a different Antrea/Kubernetes cluster.
antrea_cluster_id = "3f9be0cf-c57f-4537-932c-84d9ddfd431f-prod01-9lqzy-vks01-antrea"

# Antrea/Kubernetes cluster the vks-coredns DFW policy is bound to. Currently
# the same cluster as antrea_cluster_id above.
antrea_coredns_cluster_id = "3f9be0cf-c57f-4537-932c-84d9ddfd431f-prod01-9lqzy-vks01-antrea"
